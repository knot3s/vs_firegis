RewriteEngine On

# If the request is an existing file or directory, serve it as-is and stop.
# (This also prevents the API rewrite from looping on .php targets.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- API routing ---
# /api/foo/anything  →  api/foo.php
RewriteRule ^api/([^/]+)(/.*)?$ api/$1.php [QSA,L]

# /health  →  api/meta.php?health=1
RewriteRule ^health/?$ api/meta.php?health=1 [L]

# --- Fallback ---
RewriteRule . - [R=404,L]
